@inject Ftec.ProjetoWeb.Produtos.Apresentacao.Services.CarrinhoAPIService CarrinhoService

@{
    var nomeUsuario = Context.Session.GetString("Nome");
    var carrinho = CarrinhoService.ObterCarrinho();
    var qtdItensCarrinho = carrinho.Sum(i => i.Quantidade);
    var estaLogado = !string.IsNullOrEmpty(nomeUsuario);
}


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Ftec.ProjetoWeb.Produtos.Apresentacao</title>
    <script type="importmap"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
          rel="stylesheet">
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Ftec.ProjetoWeb.Produtos.Apresentacao.styles.css" asp-append-version="true" />
    <link rel="icon"
          type="image/svg+xml"
          href="@Url.Content("~/css/assets/White_strong_icon.svg")" />
</head>
<body>

    @*Header mobile*@
    <header class="bg-markett-blue d-md-none">
        <div class="p-2">
            <div class="d-flex align-items-center justify-content-between mb-2 px-2">
                <button class="btn p-0 border-0"
                        data-bs-toggle="offcanvas"
                        data-bs-target="#mainMenu">

                    <i class="bi bi-list fs-1 text-white"></i>
                </button>
                <a asp-controller="Home" asp-action="Index">
                    <img src="~/css/assets/White_slim_long.svg" alt="Logo Markett" height="40" />
                </a>
                <button class="btn p-0 border-0 cart-header-button">
                    @*Trocar o número pelo de itens no carrinho. Sumir se não tiver nada.*@
                    <span class="cart-items-count">@qtdItensCarrinho</span>
                    <i class="bi bi-cart3 fs-1 text-white"></i>
                </button>
            </div>
            <form asp-controller="Produto" asp-action="Index" method="get" class="flex-grow-1 mx-4">

                <div class="input-group">

                    <input type="text"
                           name="texto"
                           class="form-control"
                           placeholder="Buscar"
                           value="@Context.Request.Query["texto"]">

                    <button class="btn input-group-text search-button" type="submit">
                        <i class="bi bi-search"></i>
                    </button>

                </div>

            </form>
            
        </div>
    </header>

    @*Menu header mobile*@
    <div class="offcanvas offcanvas-start menu-mobile bg-markett-blue"
         tabindex="-1"
         id="mainMenu">

        <div class="offcanvas-header align-self-center">
            <img src="~/css/assets/White_slim_long.svg" alt="Logo Markett" height="32" />
        </div>

        <div class="offcanvas-body">

            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-person-circle fs-1 text-white"></i>
                <h5 class="text-white my-2 ">
                    Olá, @((nomeUsuario + "!") ?? "acesse sua conta!")
                </h5>
            </div>

            @if (!estaLogado)
            {
                <div class="d-flex align-items-center gap-2 w-50 my-2">
                    <a asp-controller="Auth"
                       asp-action="Login"
                       class="btn bg-white py-1 px-2">
                        Entrar
                    </a>

                    <a asp-controller="Auth"
                       asp-action="Cadastro"
                       class="btn bg-white py-1 px-2">
                        Cadastrar
                    </a>
                </div>
            }

            
            <div class="list-group list-group-flush mt-3">
                @await Component.InvokeAsync("Categorias")
            </div>

            @*Cadastrar Produto fixo*@
            @if (estaLogado)
            {
                    
                <div class="d-flex flex-column gap-2 w-100 my-2">
                    <a asp-controller="ProdutoGerenciar"
                       asp-action="Index"
                       class="btn bg-white py-1 px-2">
                        <i class="bi bi-layers me-1"></i>Gerenciar Produtos
                    </a>
                </div>
                <div class="d-flex flex-column gap-2 w-100 my-2">
                    <a asp-controller="CategoriaGerenciar"
                       asp-action="Index"
                       class="btn bg-white py-1 px-2">
                        <i class="bi bi-layers me-1"></i>Gerenciar Categorias
                    </a>
                </div>
                <div class="d-flex flex-column gap-2 w-100 my-2">
                    <a asp-controller="Estatistica"
                       asp-action="Index"
                       class="btn bg-white py-1 px-2">
                        <i class="bi bi-layers me-1"></i>Estatisticas
                    </a>
                </div>
            }

            @if (estaLogado)
            {
                <div class="d-flex flex-column gap-2 w-100 my-2">

                    <a asp-controller="Pedido"
                       asp-action="MeusPedidos"
                       class="btn bg-white py-1 px-2">
                        <i class="bi bi-bag me-1"></i>Meus Pedidos
                    </a>

                    <form asp-controller="Auth"
                          asp-action="Logout"
                          method="post">
                        <button type="submit"
                                class="btn btn-danger py-1 px-2 w-100">
                            Sair
                        </button>
                    </form>

                </div>
            }
        </div>
    </div>

    @*Header desktop*@
    <header class="bg-markett-blue d-none d-md-block">
        <div class="container ">

            <div class="d-flex align-items-center py-3">

                <a asp-controller="Home" asp-action="Index">
                    <img src="~/css/assets/White_slim_long.svg" alt="Logo Markett" height="40" />
                </a>

                <form asp-controller="Produto" asp-action="Index" method="get" class="flex-grow-1 mx-4">

                    <div class="input-group">

                        <input type="text"
                               name="texto"
                               class="form-control"
                               placeholder="Buscar"
                               value="@Context.Request.Query["texto"]">

                        <button class="btn input-group-text search-button" type="submit">
                            <i class="bi bi-search"></i>
                        </button>

                    </div>

                </form>

                <div class="d-flex align-items-center gap-4">

                    <div class="d-flex align-items-center gap-4">

                        <div class="dropdown">

                            <a href="#"
                               class="text-white text-decoration-none"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">

                                <i class="bi bi-person-circle fs-3 text-white"></i>

                            </a>

                            <ul class="dropdown-menu dropdown-menu-end">

                                @if (!estaLogado)
                                {
                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Auth"
                                           asp-action="Login">
                                            Entrar
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Auth"
                                           asp-action="Cadastro">
                                            Cadastrar
                                        </a>
                                    </li>
                                }
                                else
                                {
                                    <li class="dropdown-item-text">
                                        <i class="bi bi-person-circle me-2"></i>
                                        @nomeUsuario
                                    </li>

                                    <li><hr class="dropdown-divider" /></li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Pedido"
                                           asp-action="MeusPedidos">
                                            <i class="bi bi-bag me-2"></i>Meus Pedidos
                                        </a>
                                    </li>

                                    <li><hr class="dropdown-divider" /></li>

                                    <li>
                                        <form asp-controller="Auth"
                                              asp-action="Logout"
                                              method="post">
                                            <button class="dropdown-item text-danger" type="submit">
                                                Sair
                                            </button>
                                        </form>
                                    </li>
                                }

                            </ul>

                        </div>
                        
                        @if (estaLogado)
                        {
                            <div class="dropdown">

                                <a href="#"
                                    class="text-white text-decoration-none"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false">
                                    <i class="bi bi-gear fs-3 text-white"></i>
                                </a>

                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <a class="dropdown-item"
                                        asp-controller="ProdutoGerenciar"
                                            asp-action="Index">
                                        <i class="bi bi-layers me-2"></i>Gerenciar Produtos
                                        </a>
                                    </li>

                                        <li><hr class="dropdown-divider" /></li>

                                    <li>
                                        <a class="dropdown-item"
                                            asp-controller="CategoriaGerenciar"
                                            asp-action="Index">
                                            <i class="bi bi-tag me-2"></i>Gerenciar Categorias
                                        </a>
                                    </li>

                                        <li><hr class="dropdown-divider" /></li>

                                    <li>
                                        <a class="dropdown-item"
                                            asp-controller="Estatistica"
                                            asp-action="Index">
                                            <i class="bi bi-bar-chart-line me-2"></i>Estatisticas
                                        </a>
                                    </li>

                                </ul>

                            </div>
                        }

                        <a class="btn p-0 border-0 cart-header-button" asp-controller="Carrinho" asp-action="Index">
                            @*Trocar o número pelo de itens no carrinho. Sumir se não tiver nada.*@
                            <span class="cart-items-count">@qtdItensCarrinho</span>
                            <i class="bi bi-cart3 fs-1 text-white"></i>
                        </a>

                    </div>

                </div>

            </div>

            <div class=" border-top border-light border-opacity-25">
                <div class="d-flex align-items-center gap-4 py-2">
                    @await Component.InvokeAsync("Categorias")
            </div>
        </div>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Markett - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
