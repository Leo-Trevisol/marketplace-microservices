<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Ftec.ProjetoWeb.Produtos.Apresentacao</title>
    <script type="importmap"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
          rel="stylesheet">
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Ftec.ProjetoWeb.Produtos.Apresentacao.styles.css" asp-append-version="true" />
    <link rel="icon"
          type="image/svg+xml"
          href="@Url.Content("~/css/assets/White_strong_icon.svg")" />
</head>
<body>
    @* Header padrão
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Ftec.ProjetoWeb.Produtos.Apresentacao</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Produto" asp-action="Index">Produtos</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    *@

    @*Header mobile*@
    <header class="bg-markett-blue d-md-none">
        <div class="p-2">
            <div class="d-flex align-items-center justify-content-between mb-2 px-2">
                <button class="btn p-0 border-0"
                            data-bs-toggle="offcanvas"
                            data-bs-target="#mainMenu"
                        >

                        <i class="bi bi-list fs-1 text-white"></i>
                </button>
                <a asp-controller="Home"> <img src="~/css/assets/White_slim_long.svg" alt="Logo Markett" height="32" /></a>
                <button class="btn p-0 border-0 cart-header-button">
                    @*Trocar o número pelo de itens no carrinho. Sumir se não tiver nada.*@
                    <span class="cart-items-count">2</span>
                    <i class="bi bi-cart3 fs-1 text-white"></i>
                 </button>
            </div>
            <div class="my-2 mt-4">
                <div class="input-group">
                    <input type="text"
                           class="form-control "
                           placeholder="Buscar produtos">
                    <span class="input-group-text">
                        <i class="bi bi-search"></i>
                    </span>
                </div>
            </div>
        </div>
    </header>
    
    @*Menu header mobile*@
    <div class="offcanvas offcanvas-start menu-mobile bg-markett-blue"
         tabindex="-1"
         id="mainMenu">

        <div class="offcanvas-header align-self-center">
            <img src="~/css/assets/White_slim_long.svg" alt="Logo Markett" height="32" />
        </div>

        <div class="offcanvas-body">

            <div class="d-flex align-items-center">
                <i class="bi bi-person-circle fs-1 text-white"></i>
                <h5 class="text-white mx-2 my-0"> Olá, @(User.Identity?.Name ?? "acesse sua conta!")</h5>
            </div>

            @if (User.Identity?.IsAuthenticated != true)
            {
                <div class="d-flex align-items-center gap-2 w-50 my-2">
                    <a asp-controller="Auth"
                       asp-action="Login"
                       class="btn bg-white py-1 px-2">
                        Entrar
                    </a>

                    <a asp-controller="Auth"
                       asp-action="Cadastro"
                       class="btn bg-white py-1 px-2">
                        Cadastrar
                    </a>
                </div>
            }

            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Pedido"
                   asp-action="MeusPedidos"
                   class="btn bg-white py-1 px-2 mt-2">
                    <i class="bi bi-bag me-1"></i>Meus Pedidos
                </a>
            }

            <div class="list-group list-group-flush mt-3">

                <a href="#"
                   class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                    Eletrônicos
                    <i class="bi bi-chevron-right"></i>
                </a>

                <a href="#"
                   class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                    Informática
                    <i class="bi bi-chevron-right"></i>
                </a>

                <a href="#"
                   class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                    Casa e Decoração
                    <i class="bi bi-chevron-right"></i>
                </a>

                <a href="#"
                   class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                    Moda
                    <i class="bi bi-chevron-right"></i>
                </a>

                <a href="#"
                   class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                    Beleza
                    <i class="bi bi-chevron-right"></i>
                </a>

                <a href="#"
                   class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                    Esportes
                    <i class="bi bi-chevron-right"></i>
                </a>

                <a href="#"
                   class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                    Livros
                    <i class="bi bi-chevron-right"></i>
                </a>

                <a href="#"
                   class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                    Games
                    <i class="bi bi-chevron-right"></i>
                </a>

                <a href="#"
                   class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                    Automotivo
                    <i class="bi bi-chevron-right"></i>
                </a>

                <a href="#"
                   class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                    Ferramentas
                    <i class="bi bi-chevron-right"></i>
                </a>

            </div>
        </div>
    </div>

    @*Header desktop*@
    <header class="bg-markett-blue d-none d-md-block">
        <div class="container ">

            <div class="d-flex align-items-center py-3">

                <a asp-controller="Home"> <img src="~/css/assets/White_slim_long.svg" alt="Logo Markett" height="40" /></a>

                <div class="flex-grow-1 mx-4">

                    <div class="input-group">

                        <input type="text"
                               class="form-control"
                               placeholder="Buscar produtos">

                        <span class="input-group-text">
                            <i class="bi bi-search"></i>
                        </span>

                    </div>

                </div>

                <div class="d-flex align-items-center gap-4">

                    <div class="d-flex align-items-center gap-4">

                        <div class="dropdown">

                            <a href="#"
                               class="text-white text-decoration-none"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">

                                <i class="bi bi-person-circle fs-3 text-white"></i>

                            </a>

                            <ul class="dropdown-menu dropdown-menu-end">

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Auth"
                                       asp-action="Login">
                                        Entrar
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Auth"
                                       asp-action="Cadastro">
                                        Cadastrar
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Pedido"
                                       asp-action="MeusPedidos">
                                        <i class="bi bi-bag me-2"></i>Meus Pedidos
                                    </a>
                                </li>

                            </ul>

                        </div>

                        <button class="btn p-0 border-0 cart-header-button">
                            @*Trocar o número pelo de itens no carrinho. Sumir se não tiver nada.*@
                            <span class="cart-items-count">2</span>
                            <i class="bi bi-cart3 fs-1 text-white"></i>
                        </button>

                    </div>

                </div>

            </div>
            
            <div class=" border-top border-light border-opacity-25">
                <div class="d-flex align-items-center gap-4 py-2">
                    <a href="#" class="header-category">
                        Eletrônicos
                    </a>
                    <a href="#" class="header-category">
                        Informática
                    </a>
                    <a href="#" class="header-category">
                        Casa
                    </a>
                    <a href="#" class="header-category">
                        Moda
                    </a>
                    <a href="#" class="header-category">
                        Esportes
                    </a>
                    <a href="#" class="header-category">
                        Livros
                    </a>
                    <a href="#" class="header-category">
                        Beleza
                    </a>
                    <div class="dropdown">
                        <button class="btn btn-link p-0 categories-dropdown" data-bs-toggle="dropdown">
                            Mais
                            <i class="bi bi-chevron-down"></i>
                        </button>
                        <ul class="dropdown-menu">
                            <li>
                                <a class="dropdown-item" href="#">
                                    Automotivo
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" href="#">
                                    Games
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" href="#">
                                    Ferramentas
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Markett - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
