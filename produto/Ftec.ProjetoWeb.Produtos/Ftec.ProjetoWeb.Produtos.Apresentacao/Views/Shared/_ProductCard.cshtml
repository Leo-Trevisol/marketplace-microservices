@model ProdutoModel
@inject IConfiguration Configuration

@{
    var produtoUrl = Configuration["ProdutoBaseUrl"];
}


<a class="product-card" asp-controller="Produto" asp-action="Detalhe" asp-route-idProduto="@Model.Id">
    @if (Model.ImagemPrincipal != null)
    {
        <img class="product-card-image"
             src="@($"{produtoUrl}arquivos/{Model.ImagemPrincipal.NomeUnico}")"
             alt="@Model.Nome" />
    }
    else
    {
        <img class="product-card-image"
             src="~/images/sem-imagem.png"
             alt="Sem imagem" />
    }
    <h3 class="product-card-title">@Model.Nome</h3>
    @if (Model.Categoria != null)
    {
        <h5 class="product-card-category">@Model.Categoria.Nome</h5>
    }
    <div class="d-flex align-items-center justify-content-between">
        <p class="product-card-price">R$ @Model.Preco.ToString("N2")</p>
        <button class="product-card-cart-icon">
            <i class="bi bi-cart3 fs-6 text-black icon-shadow"></i>
        </button>
    </div>
</a>