@model Ftec.ProjetoWeb.Produtos.Apresentacao.Models.PagamentoModel

@{
    ViewData["Title"] = "Pagamento";
}

<div class="pagamento-container">

    <h2 class="pagamento-title">Finalizar Compra</h2>

    <div class="resumo-fixo-topo">
        <img src="https://unifique.com.br/upload/blog/2025/02/quem-inventou-celular.jpg"
             alt="Produto"
             class="resumo-fixo-img" />
        <div class="resumo-fixo-info">
            <p class="resumo-fixo-nome">iPhone 13 128GB Meia-Noite</p>
            <p class="text-muted small mb-0">Qtd: 1</p>
        </div>
        <span class="text-success fw-bold fs-5">R$ 3.999,00</span>
    </div>

    <form method="post" asp-controller="Pagamento" asp-action="Index">

        <input asp-for="ProdutoCodigo" type="hidden" />
        <input asp-for="ProdutoNome" type="hidden" />
        <input asp-for="ProdutoPreco" type="hidden" />

        <div class="pagamento-grid">

            <div class="pagamento-form">
                <div class="pagamento-section">
                    <h5 class="pagamento-section-title">
                        <i class="bi bi-person-fill me-2"></i>Dados Pessoais
                    </h5>

                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label">Nome completo</label>
                            <input asp-for="NomeCompleto" class="form-control" placeholder="Seu nome" />
                            <span asp-validation-for="NomeCompleto" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">E-mail</label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="email@exemplo.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Telefone</label>
                            <input asp-for="Telefone" class="form-control" placeholder="(00) 00000-0000" />
                            <span asp-validation-for="Telefone" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">CPF</label>
                            <input asp-for="Cpf" class="form-control" placeholder="000.000.000-00" />
                            <span asp-validation-for="Cpf" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="pagamento-section">
                    <h5 class="pagamento-section-title">
                        <i class="bi bi-geo-alt-fill me-2"></i>Endereço de Entrega
                    </h5>

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">CEP</label>
                            <input asp-for="Cep" class="form-control" placeholder="00000-000" />
                            <span asp-validation-for="Cep" class="text-danger small"></span>
                        </div>
                        <div class="col-md-8">
                            <label class="form-label">Endereço</label>
                            <input asp-for="Endereco" class="form-control" placeholder="Rua, Avenida..." />
                            <span asp-validation-for="Endereco" class="text-danger small"></span>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Número</label>
                            <input asp-for="Numero" class="form-control" />
                            <span asp-validation-for="Numero" class="text-danger small"></span>
                        </div>
                        <div class="col-md-5">
                            <label class="form-label">Complemento</label>
                            <input asp-for="Complemento" class="form-control" placeholder="Apto, Bloco..." />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Bairro</label>
                            <input asp-for="Bairro" class="form-control" />
                            <span asp-validation-for="Bairro" class="text-danger small"></span>
                        </div>
                        <div class="col-md-8">
                            <label class="form-label">Cidade</label>
                            <input asp-for="Cidade" class="form-control" />
                            <span asp-validation-for="Cidade" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Estado</label>
                            <select asp-for="Estado" class="form-select">
                                <option value="">UF</option>
                                <option>AC</option>
                                <option>AL</option>
                                <option>AM</option>
                                <option>BA</option>
                                <option>CE</option>
                                <option>DF</option>
                                <option>ES</option>
                                <option>GO</option>
                                <option>MA</option>
                                <option>MG</option>
                                <option>MS</option>
                                <option>MT</option>
                                <option>PA</option>
                                <option>PB</option>
                                <option>PE</option>
                                <option>PI</option>
                                <option>PR</option>
                                <option>RJ</option>
                                <option>RN</option>
                                <option>RO</option>
                                <option>RR</option>
                                <option>RS</option>
                                <option>SC</option>
                                <option>SE</option>
                                <option>SP</option>
                                <option>TO</option>
                            </select>
                            <span asp-validation-for="Estado" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="pagamento-section">
                    <h5 class="pagamento-section-title">
                        <i class="bi bi-credit-card-fill me-2"></i>Forma de Pagamento
                    </h5>

                    <div class="pagamento-metodos">
                        <label class="pagamento-metodo-label">
                            <input type="radio" asp-for="FormaPagamento" value="pix" class="d-none pagamento-metodo-radio" />
                            <div class="pagamento-metodo-card" data-metodo="pix">
                                <i class="bi bi-qr-code fs-3 text-success"></i>
                                <span>PIX</span>
                                <small class="text-success fw-bold">10% off</small>
                            </div>
                        </label>
                        <label class="pagamento-metodo-label">
                            <input type="radio" asp-for="FormaPagamento" value="credito" class="d-none pagamento-metodo-radio" />
                            <div class="pagamento-metodo-card" data-metodo="credito">
                                <i class="bi bi-credit-card fs-3 text-primary"></i>
                                <span>Crédito</span>
                                <small class="text-muted">até 12x</small>
                            </div>
                        </label>
                        <label class="pagamento-metodo-label">
                            <input type="radio" asp-for="FormaPagamento" value="boleto" class="d-none pagamento-metodo-radio" />
                            <div class="pagamento-metodo-card" data-metodo="boleto">
                                <i class="bi bi-upc fs-3 text-secondary"></i>
                                <span>Boleto</span>
                                <small class="text-muted">vence em 3 dias</small>
                            </div>
                        </label>
                    </div>
                    <span asp-validation-for="FormaPagamento" class="text-danger small"></span>

                    <div id="campos-credito" class="row g-3 mt-2" style="display:none!important">
                        <div class="col-12">
                            <label class="form-label">Número do cartão</label>
                            <input asp-for="NumeroCartao" class="form-control" placeholder="0000 0000 0000 0000" maxlength="19" />
                        </div>
                        <div class="col-md-7">
                            <label class="form-label">Nome no cartão</label>
                            <input asp-for="NomeTitular" class="form-control" placeholder="Como escrito no cartão" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Validade</label>
                            <input asp-for="Validade" class="form-control" placeholder="MM/AA" maxlength="5" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">CVV</label>
                            <input asp-for="Cvv" class="form-control" placeholder="000" maxlength="4" />
                        </div>
                        <div class="col-md-5">
                            <label class="form-label">Parcelas</label>
                            <select asp-for="Parcelas" class="form-select" id="select-parcelas">
                                {{-- preenchido via JS --}}
                            </select>
                        </div>
                    </div>

                    <div id="info-pix" style="display:none">
                        <div class="alert alert-success mt-3 mb-0">
                            <i class="bi bi-info-circle me-2"></i>
                            Após confirmar, você receberá um QR Code para pagamento via PIX.
                            O prazo de validade é de <strong>30 minutos</strong>.
                        </div>
                    </div>

                    <div id="info-boleto" style="display:none">
                        <div class="alert alert-secondary mt-3 mb-0">
                            <i class="bi bi-info-circle me-2"></i>
                            O boleto será gerado após confirmação. Prazo de vencimento: <strong>3 dias úteis</strong>.
                        </div>
                    </div>
                </div>

            </div>

            <div class="pagamento-resumo">
                <div class="pagamento-section">
                    <h5 class="pagamento-section-title">
                        <i class="bi bi-bag-fill me-2"></i>Resumo do Pedido
                    </h5>

                    <div class="d-flex gap-3 mb-3 align-items-center">
                        <img src="https://unifique.com.br/upload/blog/2025/02/quem-inventou-celular.jpg"
                             alt="@Model.ProdutoNome"
                             class="resumo-produto-img" />
                        <div>
                            <p class="fw-semibold mb-1">@Model.ProdutoNome</p>
                            <p class="text-muted small mb-0">Qtd: 1</p>
                        </div>
                    </div>

                    <hr />

                    <div class="resumo-linha">
                        <span>Subtotal</span>
                        <span>R$ @Model.ProdutoPreco.ToString("N2")</span>
                    </div>
                    <div class="resumo-linha">
                        <span>Frete</span>
                        <span class="text-success fw-semibold">Grátis</span>
                    </div>

                    <div id="desconto-pix" style="display:none">
                        <div class="resumo-linha text-success">
                            <span>Desconto PIX (10%)</span>
                            <span>- R$ @((Model.ProdutoPreco * 0.1m).ToString("N2"))</span>
                        </div>
                    </div>

                    <hr />

                    <div class="resumo-linha fw-bold fs-5">
                        <span>Total</span>
                        <span id="total-final" class="text-success">R$ @Model.ProdutoPreco.ToString("N2")</span>
                    </div>

                    <button type="submit" class="btn-buy bg-markett-blue mt-4 w-100">
                        <i class="bi bi-lock-fill me-2"></i>Confirmar Pedido
                    </button>

                    <p class="text-center text-muted small mt-3">
                        <i class="bi bi-shield-check me-1"></i>Compra 100% segura
                    </p>
                </div>
            </div>

        </div>

    </form>
</div>

@section Scripts {
    <script>
        const preco = @Model.ProdutoPreco.ToString(System.Globalization.CultureInfo.InvariantCulture);
        const precoComDesconto = (preco * 0.9).toFixed(2);

        const radios = document.querySelectorAll('.pagamento-metodo-radio');
        const cards  = document.querySelectorAll('.pagamento-metodo-card');
        const camposCredito = document.getElementById('campos-credito');
        const infoPix    = document.getElementById('info-pix');
        const infoBoleto = document.getElementById('info-boleto');
        const descontoPix = document.getElementById('desconto-pix');
        const totalFinal  = document.getElementById('total-final');
        const selectParcelas = document.getElementById('select-parcelas');

        // Preencher select de parcelas
        for (let i = 1; i <= 12; i++) {
            const val = (preco / i).toFixed(2).replace('.', ',');
            const opt = new Option(
                i === 1 ? `1x de R$ ${val} (sem juros)` : `${i}x de R$ ${val} (sem juros)`,
                i
            );
            selectParcelas.appendChild(opt);
        }

        cards.forEach(card => {
            card.closest('label').addEventListener('click', () => {
                const metodo = card.dataset.metodo;

                // Ativa visual
                cards.forEach(c => c.classList.remove('pagamento-metodo-ativo'));
                card.classList.add('pagamento-metodo-ativo');

                // Seleciona o radio
                const radio = card.closest('label').querySelector('input[type=radio]');
                radio.checked = true;

                // Mostra/oculta seções
                camposCredito.style.setProperty('display', metodo === 'credito' ? 'flex' : 'none', 'important');
                infoPix.style.display    = metodo === 'pix'    ? 'block' : 'none';
                infoBoleto.style.display = metodo === 'boleto' ? 'block' : 'none';
                descontoPix.style.display = metodo === 'pix' ? 'block' : 'none';

                // Atualiza total
                if (metodo === 'pix') {
                    totalFinal.textContent = `R$ ${precoComDesconto.replace('.', ',')}`;
                } else {
                    totalFinal.textContent = `R$ ${preco.toFixed(2).replace('.', ',')}`;
                }
            });
        });
    </script>
}