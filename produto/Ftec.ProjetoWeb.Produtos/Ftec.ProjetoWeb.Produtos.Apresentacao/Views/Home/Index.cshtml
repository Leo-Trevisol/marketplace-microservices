@{
    ViewData["Title"] = "Home Page";
}

@model HomeModel


<div class="mt-2">
    <div class="banner">
        <img class="banner-image" src="data:image/jpeg;base64," alt="Imagem de banner" />
    </div>

    <section class="home-section">
        <div class="section-header">
            <h3>Destaques</h3>
            <a asp-controller="Produto"
               asp-action="Index">Ver todos</a>
        </div>

        @if (Model.ProdutosDestaque.Count() > 0 && Model.ProdutosDestaque != null)
        {
            
        <div class="product-list">
            @foreach (var prod in Model.ProdutosDestaque.OrderBy(x => x.Nome))
            {
                <partial name="_ProductCard" model="prod" />
            }
        </div>
        }

    </section>
</div>
