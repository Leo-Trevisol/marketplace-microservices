@inject IConfiguration Configuration

@model HomeModel

@{
    ViewData["Title"] = "Home Page";
    var produtoUrl = Configuration["ProdutoBaseUrl"];
    var banner = Random.Shared.Next(1, 7); // 1 a 4
}


<div class="mt-2">
    <div class="banner">
        <img class="banner-image"
             src="@($"{produtoUrl}arquivos/banner{banner}.png")"
             alt="Banner" />
    </div>

    <section class="home-section">
        <div class="section-header">
            <h3>Destaques</h3>
            <a asp-controller="Produto"
               asp-action="Index">Ver todos</a>
        </div>

        @if (Model.ProdutosDestaque.Count() > 0 && Model.ProdutosDestaque != null)
        {
            
        <div class="product-list">
            @foreach (var prod in Model.ProdutosDestaque.OrderBy(x => x.Nome))
            {
                    

                    <partial name="_ProductCard" model="prod" />
            }
        </div>
        }

    </section>
</div>
