@using Ftec.ProjetoWeb.Produtos.Apresentacao.Models;

@{
    ViewData["Title"] = "Produtos";
}

@model List<ProdutoModel>

<div class="container mt-5">
    <div class="row">
        <div class="col-md-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>Produtos</h2>
            </div>

            <form method="get" asp-controller="Produto" asp-action="Index" class="row g-2 mb-4">
                <div class="col-md-8">
                    <input type="text"
                            name="texto"
                            value="@Context.Request.Query["texto"]"
                            class="form-control"
                            placeholder="Buscar por nome ou código..." />
                </div>
                <div class="col-md-3">
                    <select name="idCategoria" class="form-select">
                        <option value="">Todas as categorias</option>
                        @if(ViewBag.Categorias != null)
                        {                                
                            foreach (var cat in ViewBag.Categorias as List<CategoriaModel>)
                            {
                                <option value="@cat.Id"
                                        selected="@(Context.Request.Query["idCategoria"] == cat.Id.ToString())">
                                    @cat.Nome
                                </option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-1">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search"></i>
                    </button>
                </div>
            </form>

            @if (Model.Count() > 0 && Model != null){
                <div class="product-list">
                    @foreach (var prod in Model.OrderBy(x => x.Nome))
                    {
                        <partial name="_ProductCard" model="prod" />
                    }
                </div>
            }
            else{
                <div class="alert alert-info">
                    Nenhum produto cadastrado.
                </div>
            }
        </div>
    </div>
</div>


