@model Ftec.ProjetoWeb.Produtos.Apresentacao.Models.API.APICategoriaModel

@{
    ViewData["Title"] = "Editar Categoria";
}

<div class="cadastro-produto-container">

    <div class="cadastro-produto-header">
        <div>
            <h2 class="cadastro-produto-title">Editar Categoria</h2>
            <p class="text-muted mb-0">Atualize as informações da categoria</p>
        </div>
        <a asp-controller="CategoriaGerenciar" asp-action="Index"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i>Ver categorias
        </a>
    </div>

    @if (ViewBag.Erro != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle me-2"></i>@ViewBag.Erro
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form method="post" asp-controller="CategoriaGerenciar" asp-action="Editar">

        @* Mantém o Id da categoria no post de atualização *@
        <input type="hidden" asp-for="Id" />

        <div class="cadastro-produto-grid">

            <div>
                <div class="pagamento-section">
                    <h5 class="pagamento-section-title">
                        <i class="bi bi-tag-fill me-2"></i>Identificação
                    </h5>
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label">Nome da categoria <span class="text-danger">*</span></label>
                            <input asp-for="Nome" class="form-control" placeholder="ex: Informática" />
                            <span asp-validation-for="Nome" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Descrição</label>
                            <textarea asp-for="Descricao"
                                      class="form-control"
                                      rows="6"
                                      placeholder="Descreva as características desta categoria..."></textarea>
                            <span asp-validation-for="Descricao" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div>
                <div class="pagamento-section">
                    <h5 class="pagamento-section-title">
                        <i class="bi bi-diagram-3-fill me-2"></i>Estrutura Hierárquica
                    </h5>
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label">Categoria Pai</label>
                            @* O ASP.NET Core já selecionará automaticamente o pai atual baseado no valor de Model.ParentId *@
                            <select asp-for="ParentId" class="form-select" asp-items="ViewBag.ParentIdDropdown">
                            </select>
                            <span asp-validation-for="ParentId" class="text-danger small"></span>
                            <p class="text-muted small mt-1 mb-0">
                                Altere para "[ Nenhuma ]" se desejar transformar esta categoria em uma Categoria Raiz.
                            </p>
                        </div>
                    </div>
                </div>

                <button type="submit" class="btn-buy bg-markett-blue w-100 mt-2">
                    <i class="bi bi-check-circle me-2"></i>Salvar Alterações
                </button>

                <a asp-controller="CategoriaGerenciar" asp-action="Index"
                   class="btn btn-outline-secondary w-100 mt-2">
                    Cancelar
                </a>
            </div>

        </div>

    </form>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}